# Use the same public HTTPS origin at build time and runtime.
SITE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/inquiries.sqlite
# Generate: openssl rand -hex 32. Required in production; never commit the result.
RATE_LIMIT_SECRET=
# Set to 1 only behind ONE trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=0

# Optional email notifications; inquiries are saved even when email is unavailable.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
INQUIRY_FROM=
INQUIRY_TO=
